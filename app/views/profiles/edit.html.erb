<h1>プロフィール編集</h1>

<%= form_with model: @user, url: profile_path, method: :patch do |f| %>
  <div>
    <%= f.label :avatar, "アイコン画像" %><br>
    <% if @user.respond_to?(:avatar) && @user.avatar.attached? %>
      <%= image_tag @user.avatar, size: "80x80" %><br>
    <% end %>
    <%= f.file_field :avatar %>
  </div>

  <div>
    <%= f.label :name, "名前" %><br>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :bio, "自己紹介" %><br>
    <%= f.text_area :bio, rows: 4 %>
  </div>

  <div>
    <%= f.submit "更新する" %>
  </div>
<% end %>

<%= link_to "戻る", account_path %>