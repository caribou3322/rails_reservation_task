<h1>施設検索</h1>

<%# 検索フォーム %>
<%= form_with url: search_rooms_path, method: :get, local: true do |f| %>
  <div>
    <%= f.label :area, "エリア検索" %>
    <%= f.select :area, ["東京", "大阪", "京都", "札幌"], { include_blank: "すべて", selected: params[:area] } %>
  </div>

  <div>
    <%= f.label :keyword, "フリーワード検索" %>
    <%= f.text_field :keyword, value: params[:keyword], placeholder: "施設名・詳細を入力" %>
  </div>

  <%= f.submit "検索" %>
<% end %>

<hr>

<%# 検索結果の表示 %>
<h2>検索結果：<%= @rooms.count %>件</h2>

<% @rooms.each do |room| %>
  <div style="border: 1px solid #ccc; padding: 10px; margin-bottom: 10px;">
    <%= image_tag room_image(room), size: "150x100" %>
    <h3><%= link_to room.name, room_path(room) %></h3>
    <p>住所：<%= room.address %></p>
    <p><%= room.description %></p>
    <p>宿泊料金：<%= number_to_currency(room.price, unit: "¥", precision: 0) %> / 泊</p>
  </div>
<% end %>
