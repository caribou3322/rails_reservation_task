<h1>登録済み施設一覧</h1>

<% if @rooms.any? %>
  <table border="1" cellpadding="10" cellspacing="0">
    <thead>
      <tr>
        <th>施設画像</th>
        <th>施設名</th>
        <th>紹介文</th>
        <th>宿泊料金（1泊）</th>
        <th>作成日</th>
      </tr>
    </thead>
    <tbody>
      <% @rooms.each do |room| %>
        <tr>
          <td><%= image_tag room_image(room), size: "120x80" %></td>
          <td><%= link_to room.name, room_path(room) %></td>
          <td><%= room.description %></td>
          <td><%= number_to_currency(room.price, unit: "¥", precision: 0) %></td>
          <td><%= room.created_at.strftime("%Y/%m/%d") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>登録済みの施設はまだありません。</p>
<% end %>

<br>
<%= link_to "新しく施設を登録する", new_room_path %>
